# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-openai-api-key

# Text model for chat/text mode (optional).
# If not set (or set to "latest"), fallback is gpt-5.5.
# OPENAI_TEXT_MODEL=gpt-5.5

# Telegram Bot Token (required for Telegram mode)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=DEBUG

# Путь к файлу persistence (по умолчанию bot_data.pickle)
# В Docker: BOT_DATA_PATH=/data/bot_data.pickle
# BOT_DATA_PATH=/data/bot_data.pickle

# Веб-интерфейс (pusplexity-web в docker-compose)
# Обязательно задайте длинный случайный секрет (без fallback в коде).
# FLASK_SECRET_KEY=replace-with-very-long-random-secret

# Имя ACME resolver в Traefik — как в аргументах контейнера:
#   certificatesresolvers.<ИМЯ>.acme...
# Примеры: letsencrypt, mytlschallenge
# TRAEFIK_CERT_RESOLVER=mytlschallenge
